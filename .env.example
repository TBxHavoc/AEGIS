AEGIS_HOST=127.0.0.1
AEGIS_PORT=8765
AEGIS_LOG_LEVEL=INFO
AEGIS_MAX_MESSAGE_CHARS=4000
AEGIS_MAX_SESSIONS=32
AEGIS_STATIC_DIR=frontend
AEGIS_DATA_DIR=data
AEGIS_PERSIST_CONVERSATIONS=0
AEGIS_HISTORY_LIMIT=20
AEGIS_KNOWLEDGE_ROOT=data/knowledge_documents
AEGIS_TOOL_TIMEOUT=5
AEGIS_MODEL_PATH=
AEGIS_MODEL_CONTEXT=1024
AEGIS_MODEL_THREADS=2
AEGIS_INFERENCE_TIMEOUT=120
AEGIS_MODEL_MAX_TOKENS=256
AEGIS_MODEL_TEMPERATURE=0.2
AEGIS_MODEL_TOP_P=0.9
AEGIS_MODEL_REPEAT_PENALTY=1.1
AEGIS_MODEL_MEMORY_FRACTION=0.75
# Optional system instruction, no model loads until a request is made.
# AEGIS_SYSTEM_PROMPT=You are AEGIS, a helpful, honest personal assistant.
AEGIS_PIPER_EXECUTABLE=
AEGIS_PIPER_MODEL=
# Optional local STT. Configure only one provider; no model is downloaded.
AEGIS_STT_PROVIDER=
AEGIS_WHISPER_EXECUTABLE=whisper-cli
AEGIS_WHISPER_MODEL=
AEGIS_VOSK_MODEL=
AEGIS_STT_TIMEOUT_SECONDS=60
AEGIS_VAD_THRESHOLD=0.018
AEGIS_VAD_MIN_SPEECH_MS=240
AEGIS_VAD_SILENCE_MS=1100
AEGIS_VAD_MAX_RECORDING_MS=30000
# Agent workflows are deterministic by default; parallel work is capped at two.
AEGIS_AGENT_MAX_PARALLEL=1
AEGIS_AGENT_TIMEOUT_SECONDS=30
# Local file access is limited to these approved roots. Leave empty for the
# knowledge root only. Use the platform path separator to list several roots.
AEGIS_FILE_ROOTS=
# Code tools are unavailable until one or more project roots are approved.
AEGIS_PROJECT_ROOTS=
# Defaults remain read-only. Higher-risk tools also require local confirmation.
AEGIS_MAX_PERMISSION=READ_ONLY
AEGIS_ALLOW_NETWORK=0
# AEGIS_ALLOWED_TOOLS replaces the built-in allowlist when explicitly set.
# AEGIS_ALLOWED_TOOLS=system.status,system.diagnostics,knowledge.search,time.now,file.metadata,document.read,file.list,file.search,file.find,file.hash,data.csv.analyze,data.json.inspect,data.csv.transform,data.csv.trend,data.csv.chart,code.syntax_check
# Set to duckduckgo to enable the no-key HTML search provider. Network permission
# must also be enabled and web.search/web.fetch added to AEGIS_ALLOWED_TOOLS.
AEGIS_WEB_PROVIDER=
# MCP connections require explicit environment configuration and a local
# confirmed POST to /api/mcp/connect. Credentials are read from the named env var.
AEGIS_MCP_ENDPOINT=
AEGIS_MCP_SERVER_ID=configured
AEGIS_MCP_APPROVED=0
AEGIS_MCP_BEARER_ENV=
AEGIS_MCP_TIMEOUT_SECONDS=10
# Override the generated data/api.token with a URL-safe token of 32+ characters.
# The minimalist browser UI prompts for it and retains it only for the tab session.
AEGIS_API_TOKEN=
# Remote binding is rejected unless explicitly enabled with a token. Put a trusted
# TLS proxy and network policy in front; remote mutations remain denied.
AEGIS_ALLOW_REMOTE=0
# Lightweight watchdog thresholds; no host processes are killed.
AEGIS_MAX_RSS_MB=1800
AEGIS_MAX_CPU_PERCENT=250
AEGIS_MIN_FREE_DISK_MB=128

